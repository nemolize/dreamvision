amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"

local jsGlob = List("*.js", "*.mjs", "*.jsx", "*.ts", "*.tsx")
local formatGlob = List("*.js", "*.mjs", "*.jsx", "*.ts", "*.tsx", "*.json", "*.md", "*.yml", "*.yaml", "*.css", "*.html")

// post-merge gets no changed-file list, so `glob` matches nothing and the diff
// runs in-command; `--quiet` exits 1 on a match, which `|| rc=$?` absorbs.
local function installIfChanged(files: List<String>, install: String): String =
    let (pathspecs = files.map((f) -> "':(top)\(f)'").join(" "))
        "rc=0; git diff --quiet ORIG_HEAD HEAD -- \(pathspecs) || rc=$?; case $rc in 0) ;; 1) \(install) ;; *) echo 'post-merge: git diff ORIG_HEAD HEAD failed' >&2; exit 1 ;; esac"

local linters = new Mapping<String, Step> {
    ["eslint"] {
        glob = jsGlob
        stage = jsGlob
        check = "pnpm exec eslint {{files}}"
        fix = "pnpm exec eslint --fix {{files}}"
    }
    ["prettier"] {
        glob = formatGlob
        stage = formatGlob
        check = "pnpm exec prettier --check {{files}}"
        fix = "pnpm exec prettier --write {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["post-merge"] {
        steps {
            ["pnpm-install"] {
                check = installIfChanged(List("pnpm-lock.yaml"), "pnpm install")
            }
            ["mise-install"] {
                check = installIfChanged(List("mise.toml", ".mise.toml"), "mise install")
            }
        }
    }
}
